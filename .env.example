# FLoRA Validator — environment variables
# Copy this file to .env and fill in your values.
#
# Full setup instructions: docs/SETUP.md

# ── Supabase PostgreSQL connection string (required) ──────────────────────────
# Get from: Supabase dashboard → Settings → Database → Connection String → URI
# Format:   postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── First-run administrator (set this before the first start) ─────────────────
# REQUIRED when the admins table is empty: with no value the application refuses
# to start rather than seeding an account whose password is public. There is no
# longer any fallback password in the code.
#
# Used only to create the very first administrator. Changing it later does not
# rotate an existing password - use the admin panel, or admin_password.py to
# recover from a lockout. Stored as an Argon2id hash, never in plaintext.
ADMIN_HANDLE=flora_muenster
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Public origin used to build administrator invitation and recovery links.
# Must match how people actually reach the app, or the emailed link 404s.
APP_BASE_URL=https://validation.forrt.org

# Extra origins allowed to make state-changing requests, comma separated.
# APP_BASE_URL is always allowed; set this only if the app is reached by
# more than one hostname.
ALLOWED_ORIGINS=

# Set to 1 ONLY for local development over plain http://localhost, where a
# Secure cookie would never be sent. Never set it in production: it allows
# the session cookie to travel unencrypted.
SESSION_COOKIE_INSECURE=

# ── Google Gemini API key (required for LLM validation) ───────────────────────
# Get from: https://aistudio.google.com → Get API key → Create API key
# Free tier: 15 req/min, 1M tokens/day — no credit card needed
GEMINI_API_KEY=AIzaSy...

# ── GitHub personal access token (optional — only for private repos) ──────────
# Get from: GitHub → Settings → Developer settings → Fine-grained tokens
# Permissions needed: Contents: Read-only on the source repo
# Leave blank if forrtproject/flora-extractor is public
GITHUB_TOKEN=

# ── GitHub source repo for nightly CSV sync ───────────────────────────────────
# Change only if you've forked the extractor repo
GITHUB_REPO=forrtproject/flora-extractor
GITHUB_BRANCH=main

# Optional filter-engine routing release attached to nightly-imported metadata.
# Set this to the manifest/release id that produced the current extracted.csv.
ROUTING_RELEASE_ID=

# Directory holding extracted_latest.csv and the immutable per-run snapshot
# archives. REQUIRED on shared durable storage (a ReadWriteMany PVC) for any
# deployment that replaces pods: Parts 2 and 3 read the exact archive Part 1
# imported, identified by sha256, and refuse to run when it is not present.
# A pod-local directory makes orphan cleanup block after every pod replacement.
EXTRACTOR_DATA_DIR=data

# Optional combined append-only log for nightly sync/report and manual cleanup.
# In Kubernetes, mount this directory on persistent storage if file retention
# across pod replacement is required. The same output is also sent to stdout.
EXTRACTOR_MAINTENANCE_LOG=logs/extractor_maintenance.log

# Snapshot removal guard. A candidate that removes MORE than this percentage
# of resolved pair IDs is not imported/promoted, orphan reporting is skipped,
# and the failed run cannot authorize a later manual cleanup.
# Must be a finite number from 0 through 100; invalid/NaN/infinite values block
# synchronization before any download or import starts.
EXTRACTOR_MAX_REMOVAL_PERCENT=10

# Terminate a hung sync/report/cleanup child and fail the pipeline. The default
# is two hours per stage; later stages remain skipped after a timeout.
EXTRACTOR_STAGE_TIMEOUT_SECONDS=7200

# Allow the owner of a queued run to wait through a brief competing lock check.
# This does not permit overlap; it only avoids cancelling a valid queued run.
EXTRACTOR_LOCK_WAIT_SECONDS=15

# Short-lived capability used only after the server confirms a queued judgement
# failed before commit. Raw stamps are never stored in the database.
SUBMISSION_FAILURE_STAMP_TTL_MINUTES=30

# How many reverse proxies YOU run sit in front of this app. The client address
# is read that many entries from the right of X-Forwarded-For, because each
# proxy appends the address it saw and anything further left was supplied by the
# caller. It decides which address the sign-in throttle counts against and which
# one lands in the security-event log.
#   1 = the documented deployment (one platform router in front of uvicorn)
#   0 = nothing proxies this app; ignore the header and use the peer address
# Set it too high and addresses resolve to a proxy — inaccurate, but never
# caller-controlled. Set it too low and a caller can choose their own.
TRUSTED_PROXY_HOPS=1

# FLoRA reference preparation. The supplied workbook/cache seed are bundled.
# Optional overrides accept an absolute path or a path relative to the repo.
FLORA_MANUAL_REFERENCES=data/manual_references.xlsx
FLORA_REFERENCE_SEED=data/reference_metadata_seed.json.gz
# OPENALEX_MAILTO=your-contact-email
# UNPAYWALL_EMAIL=your-contact-email
# Optional separate DynamoDB/API derivative, preserving the main flora.csv.
FLORA_API_FILTER=0

# Extra browser origins for the public /v1/search API, comma separated.
# https://forrt.org is always allowed. Other public lookups allow any origin.
# This does not grant access to administrator routes or permit data writes.
FLORA_SEARCH_ORIGINS=
